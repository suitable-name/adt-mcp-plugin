<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <!-- MCP Server View -->
   <extension point="org.eclipse.ui.views">
      <category
            id="com.sap.adt.mcp.category"
            name="SAP ADT MCP">
      </category>
      <view
            id="com.sap.adt.mcp.server.view"
            name="SAP ADT Relay"
            category="com.sap.adt.mcp.category"
            class="com.sap.adt.mcp.ui.McpServerView"
            icon="icons/claude.png"
            restorable="true">
      </view>
   </extension>

   <!-- Perspective Extension - Add to ABAP perspective -->
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="com.sap.adt.ui.AbapPerspective">
         <viewShortcut id="com.sap.adt.mcp.server.view"/>
      </perspectiveExtension>
   </extension>

   <!-- Preferences -->
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="com.sap.adt.mcp.preferences.PreferenceInitializer"/>
   </extension>

   <!-- Preference page: the global settings of this plugin. Per-desktop permissions are set in
        the SAP ADT Relay view (context menu of a paired desktop). -->
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="com.sap.adt.mcp.preferences.root"
            name="MCP Relay"
            class="com.sap.adt.mcp.preferences.McpRelayPreferencePage">
         <keywordReference id="com.sap.adt.mcp.preferences.keywords"/>
      </page>
   </extension>

   <!-- Words the preference filter matches for this page, besides its name. -->
   <extension point="org.eclipse.ui.keywords">
      <keyword
            id="com.sap.adt.mcp.preferences.keywords"
            label="mcp relay sap adt permissions read-only tools package patterns encryption encrypted unencrypted desktop">
      </keyword>
   </extension>

</plugin>
